# Copy to .env.production and replace every placeholder before deployment.
# Generate secret values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ORIGIN=https://hrms.example.com
MINIO_ENDPOINT=storage.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-a-production-scoped-access-key
MINIO_SECRET_KEY=replace-with-a-production-scoped-secret-key
MINIO_BUCKET=hrms-uploads
MINIO_PUBLIC_ENDPOINT=storage.example.com
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=hrms_admin
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
POSTGRES_DB=hrms_db

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Optional outbound email configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Proteccio HRMS
SMTP_FROM_EMAIL=