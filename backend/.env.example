# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Docker Compose maps the container's 5432 to HOST port 5433 (see
# docker-compose.yml), so the host-run API connects on 5433.
DATABASE_URL="postgresql://hrms_admin:hrms_password@localhost:5433/hrms_db?schema=public"

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 64
JWT_ACCESS_SECRET="change-me-access-secret-64-chars-minimum-length-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-64-chars-minimum-length-please"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (frontend dev default below)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
