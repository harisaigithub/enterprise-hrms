model HelpdeskTicket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber       String    @unique @map("ticket_number") @db.VarChar(20)
  requesterId        String    @map("requester_id") @db.Uuid
  assignedToId       String?   @map("assigned_to_id") @db.Uuid
  category           String    @db.VarChar(50)
  queue              String    @db.VarChar(80)
  subject            String    @db.VarChar(160)
  description        String    @db.Text
  priority           String    @default("Medium") @db.VarChar(20)
  status             String    @default("Open") @db.VarChar(30)
  isConfidential     Boolean   @default(false) @map("is_confidential")
  attachmentFileName String?   @map("attachment_file_name") @db.VarChar(255)
  slaDeadline        DateTime  @map("sla_deadline") @db.Timestamp(6)
  resolutionNotes    String?   @map("resolution_notes") @db.Text
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamp(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamp(6)
  reopenedAt         DateTime? @map("reopened_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  requester Employee          @relation("HelpdeskRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedTo Employee?        @relation("HelpdeskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments   HelpdeskComment[]

  @@index([requesterId, createdAt])
  @@index([queue, status])
  @@index([assignedToId])
  @@index([slaDeadline])
  @@map("helpdesk_tickets")
}

model HelpdeskComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  message    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Employee       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("helpdesk_comments")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChecklistItemStatus {
  Pending
  Complete
  Blocked
  Pending_Procurement
}

model Onboarding {
  id String @id @default(uuid())

  employeeId String  @unique
  offerId    String? @unique

  joinDate         DateTime
  probationEndDate DateTime
  buddy            String?

  status OnboardingStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistItems OnboardingChecklistItem[]

  @@index([status])
  @@index([joinDate])
}

model OnboardingChecklistItem {
  id String @id @default(uuid())

  onboardingId String

  title    String
  category String
  owner    String

  dueDate DateTime
  status  ChecklistItemStatus @default(Pending)

  dependsOn     String?
  blockedReason String?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([status])
  @@index([dependsOn])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  LOCKED
}

enum CourseContentType {
  TEXT
  PDF
  VIDEO
  LINK
}

model Course {
  id             String       @id @default(cuid())
  title          String
  description    String?
  thumbnailUrl String?
  contentModules Json
  isCompliance   Boolean      @default(false)
  expiryMonths   Int?
  passThreshold  Int          @default(70)
  status         CourseStatus @default(DRAFT)
  version       Int     @default(1)
  versionGroupId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrollments CourseEnrollment[]
  questions   CourseQuizQuestion[]

  contents CourseContent[]

  @@index([status])
  @@index([isCompliance])
  @@index([versionGroupId])
  @@map("courses")
}

model CourseEnrollment {
  id           String @id @default(cuid())
  courseId     String
  employeeId   String @db.Uuid
  employeeName String

  status   EnrollmentStatus @default(NOT_STARTED)
  attempts Int              @default(0)
  score    Int?

  certifiedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  quizAttempts CourseQuizAttempt[]

  contentProgress CourseContentProgress[]

  certificate CourseCertificate?

  @@unique([courseId, employeeId])
  @@index([employeeId])
  @@index([courseId])
  @@index([status])
  @@index([expiresAt])
  @@map("course_enrollments")
}

model CourseContent {
  id         String            @id @default(cuid())
  courseId   String

  moduleName String
  title      String

  type       CourseContentType
  content    String?
  fileUrl    String?
  order      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([type])
  @@unique([courseId, order])
  @@map("course_contents")
}

model CourseQuizQuestion {
  id       String @id @default(cuid())
  courseId String
  question String
  order    Int

  course  Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options CourseQuizOption[]
  answers CourseQuizAttemptAnswer[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("course_quiz_questions")
}

model CourseQuizOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)

  question CourseQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("course_quiz_options")
}

model CourseQuizAttempt {
  id           String @id @default(cuid())
  enrollmentId String

  attemptNumber  Int
  correctCount   Int
  totalQuestions Int
  score          Int
  passed         Boolean

  attemptedAt DateTime @default(now())

  enrollment CourseEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  answers    CourseQuizAttemptAnswer[]

  @@unique([enrollmentId, attemptNumber])
  @@index([enrollmentId])
  @@map("course_quiz_attempts")
}

model CourseQuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  isCorrect  Boolean

  attempt  CourseQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question CourseQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("course_quiz_attempt_answers")
}

enum CourseContentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model CourseContentProgress {
  id           String                     @id @default(cuid())
  enrollmentId String
  contentId    String

  status       CourseContentProgressStatus @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, contentId])
  @@index([enrollmentId])
  @@index([contentId])
  @@map("course_content_progress")
}

enum CertificateStatus {
  PENDING
  GENERATED
  ISSUED
  EXPIRED
  REVOKED
}

model CourseCertificate {
  id                String            @id @default(cuid())
  enrollmentId      String            @unique
  certificateNumber String            @unique

  status            CertificateStatus @default(PENDING)

  issuedAt          DateTime?
  expiresAt         DateTime?

  certificateUrl    String?
  storageKey        String?

  verificationToken String            @unique
  pdfSha256         String?

  generatedAt       DateTime?
  revokedAt         DateTime?
  revokeReason      String?

  downloadCount     Int               @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([certificateNumber])
  @@index([verificationToken])
  @@index([status])
  @@map("course_certificates")
}

