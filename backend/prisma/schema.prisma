model Offer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String    @unique @map("application_id") @db.Uuid
  proposedSalary  Decimal   @map("proposed_salary") @db.Decimal(12, 2)
  status          String    @default("Draft") @db.VarChar(40)
  consentOnFile   Boolean   @default(false) @map("consent_on_file")
  financeOverride Boolean   @default(false) @map("finance_override")
  overrideReason  String?   @map("override_reason") @db.Text
  sentAt          DateTime? @map("sent_at") @db.Date
